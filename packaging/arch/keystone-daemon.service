[Unit]
Description=Keystone Router/Firewall Daemon
Documentation=https://github.com/example/keystone
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/keystone-daemon
Restart=on-failure
RestartSec=5

# Security hardening
# Run as root (required for network configuration)
User=root
Group=root

# Create runtime directory for socket
RuntimeDirectory=keystone
RuntimeDirectoryMode=0755

# State directory for SQLite database
StateDirectory=keystone
StateDirectoryMode=0700

# Restrict capabilities
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_ADMIN CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_ADMIN CAP_CHOWN

# Filesystem restrictions
ProtectHome=yes
ProtectSystem=strict
# Keystone generates these files; the rest of /etc remains read-only.
ReadWritePaths=/etc/systemd/network /etc/nftables.conf /var/lib/keystone /run/keystone
ReadWritePaths=-/etc/dnsmasq.conf -/etc/dnsmasq.d -/var/lib/dnsmasq -/etc/caddy -/var/log/caddy
PrivateTmp=yes

# Additional hardening
NoNewPrivileges=yes
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=keystone-daemon

[Install]
WantedBy=multi-user.target
