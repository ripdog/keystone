[Unit]
Description=Keystone Router/Firewall Daemon
Documentation=https://github.com/example/keystone
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/keystone-daemon
Restart=on-failure
RestartSec=5

# Security hardening
# Run as root (required for network configuration)
User=root
Group=root

# Create runtime directory for socket
RuntimeDirectory=keystone
RuntimeDirectoryMode=0755

# State directory for SQLite database
StateDirectory=keystone
StateDirectoryMode=0750

# Restrict capabilities
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_ADMIN

# Filesystem restrictions
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/systemd/network /etc/nftables.conf /var/lib/keystone /run/keystone
PrivateTmp=yes

# Additional hardening
NoNewPrivileges=no
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=keystone-daemon

[Install]
WantedBy=multi-user.target
