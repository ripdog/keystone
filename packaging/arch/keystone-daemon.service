[Unit]
Description=Keystone Router/Firewall Daemon
Documentation=https://github.com/example/keystone
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/keystone-daemon
Restart=on-failure
RestartSec=5

# Security hardening
# Run as root (required for network configuration)
User=root
Group=root

# Create runtime directory for socket
RuntimeDirectory=keystone
RuntimeDirectoryMode=0755

# State directory for SQLite database
StateDirectory=keystone
StateDirectoryMode=0700

# Ensure managed configuration directories exist before the read-only
# filesystem sandbox is constructed (Caddy itself remains optional).
# miniupnpd and keystone-blocky are created here too, so /etc/miniupnpd and
# /etc/keystone-blocky exist before the sandbox is built; the write access they
# need is granted below. So is /etc/avahi (multicast DNS).
ConfigurationDirectory=systemd/networkd.conf.d dnsmasq.d caddy/Caddyfile.d miniupnpd keystone-blocky avahi
ConfigurationDirectoryMode=0755

# Restrict capabilities
# The DHCP session reset (dhcp_session.rs) sends a DHCPRELEASE from port 68
# bound to the WAN device (CAP_NET_BIND_SERVICE, CAP_NET_RAW) and takes the link
# down (CAP_NET_ADMIN). It also runs `networkctl status` and `systemd-run`, which
# reach networkd and systemd over their sockets and need no filesystem write
# access. A unit test keeps these capabilities in place.
# CAP_SETUID/SETGID let Caddy validation drop to the caddy service identity.
# Packet capture (capture/mod.rs) uses CAP_NET_RAW for tcpdump's raw socket, and
# CAP_SETUID/SETGID so setpriv can start the packet decoder as nobody. The
# capture file goes in /run/keystone/capture, under RuntimeDirectory= below. A
# unit test keeps these in place.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_ADMIN CAP_CHOWN CAP_SETUID CAP_SETGID
# Both capabilities must also be ambient: subprocesses otherwise lose
# CAP_SETUID during Caddy's setgid/setgroups/setuid sequence.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_ADMIN CAP_CHOWN CAP_SETUID CAP_SETGID

# Filesystem restrictions
# Read-only (not hidden) so SSH lockout validation can see ~/.ssh/authorized_keys.
ProtectHome=read-only
# ProtectSystem=strict keeps /usr readable (read-only), so the clients page can
# read the MAC vendor registry at /usr/share/hwdata/oui.txt (package hwdata).
ProtectSystem=strict
# Keystone generates these files; the rest of /etc remains read-only.
ReadWritePaths=/etc/systemd/network /etc/systemd/networkd.conf.d /etc/sysctl.d /etc/nftables.conf /var/lib/keystone /run/keystone
ReadWritePaths=/etc/ssh/sshd_config.d
# Match Caddy's packaged service storage paths. The daemon's validator runs
# as the caddy user, so the caddy-owned log/state directories remain private.
ReadWritePaths=-/etc/dnsmasq.conf -/var/lib/dnsmasq
ReadWritePaths=/etc/caddy -/var/log/caddy -/var/lib/caddy -/run/caddy
# UPnP: Keystone writes /etc/miniupnpd/miniupnpd.conf (atomically, via a temp
# file in the same directory). miniupnpd's lease file in /var/lib/miniupnpd
# (its StateDirectory, root-owned, created by miniupnpd.service) is only read,
# to list mappings. /var/lib is not hidden by the sandbox, so no path is
# writable for it here. Mapping rules live in the nftables table keystone_upnp,
# which needs CAP_NET_ADMIN like the rest of the firewall.
ReadWritePaths=/etc/miniupnpd
# DNS filtering: Keystone writes /etc/keystone-blocky/config.yml the same way
# (atomically, via a temp file in the same directory). Blocky's query log under
# /var/lib/keystone-blocky is only read, to show queries. It is owned by the
# dynamic user of keystone-blocky.service and is world-readable (0755 directory,
# 0644 files), so this daemon, which lacks CAP_DAC_OVERRIDE, reads it as an
# ordinary user would; /var/lib itself is read-only here, not hidden.
ReadWritePaths=/etc/keystone-blocky
# Multicast DNS: Keystone writes /etc/avahi/avahi-daemon.conf (atomically, via a
# temp file in the same directory) and starts or stops avahi-daemon.service
# over D-Bus, which needs no filesystem access of its own.
ReadWritePaths=/etc/avahi
PrivateTmp=yes

# Additional hardening
NoNewPrivileges=yes
ProtectKernelTunables=no
# SQM traffic shaping needs sch_cake, ifb, act_mirred and cls_matchall. They
# are loaded at boot by keystone-modules.conf, not by this daemon.
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=keystone-daemon

[Install]
WantedBy=multi-user.target
